### Clean helpers

# Confirm and rm, displaying a tree via `lt` (eza --tree --icons).
# Usage: _confirm_rm_lt "<description>" <tree-path> <delete-target>...
_confirm_rm_lt() {
  local desc="$1"; shift
  local tree="$1"; shift
  if [[ $# -eq 0 ]]; then
    echo "No files to delete: $desc"
    return 0
  fi
  local count=$(find "$@" -type f 2>/dev/null | wc -l | tr -d ' ')
  echo "Files to delete ($desc):"
  eza --tree --icons "$tree"
  read -q "?Delete $count file(s)? [y/N] "
  local reply_status=$?
  echo
  if [[ $reply_status -ne 0 ]]; then
    echo "Cancelled."
    return 1
  fi
  rm -rfv "$@"
}

# Confirm and rm files on Android device via adb.
# Usage: _confirm_adb_rm "<description>" <adb-path>
_confirm_adb_rm() {
  local desc="$1"
  local adbpath="$2"
  local tmpdir=$(mktemp -d)
  local mirror="$tmpdir/tree"
  mkdir -p "$mirror"

  adb shell "cd '$adbpath' && find . -type d" 2>/dev/null \
    | tail -n +2 | while IFS= read -r d; do
        local rel=${d#./}
        [[ -z "$rel" ]] && continue
        mkdir -p "$mirror/$rel"
      done
  adb shell "cd '$adbpath' && find . -type f" 2>/dev/null \
    | while IFS= read -r f; do
        local rel=${f#./}
        [[ -z "$rel" ]] && continue
        mkdir -p "$mirror/$(dirname "$rel")"
        : > "$mirror/$rel"
      done

  local count=$(adb shell "cd '$adbpath' && find . -type f" 2>/dev/null | wc -l | tr -d ' ')
  if [[ "$count" -eq 0 ]]; then
    rm -rf "$tmpdir"
    echo "No files to delete on phone: $desc ($adbpath)"
    return 0
  fi

  echo "Files to delete on phone ($desc):  ($adbpath)"
  eza --tree --icons "$mirror" | tail -n +2
  rm -rf "$tmpdir"

  read -q "?Delete $count file(s) listed above? [y/N] "
  local reply_status=$?
  echo
  if [[ $reply_status -ne 0 ]]; then
    echo "Cancelled."
    return 1
  fi
  adb shell "rm -rv '$adbpath'/*"
}

