## System

### Power

#### Off

alias power_off="sudo shutdown -h now"

#### Reboot

alias power_reboot="sudo shutdown -r now"

### Update

alias system_update="$ZSCRIPTS/environment/system_update_macos"

### Clean Up | DS Files

alias ds_cleanup="sudo find . -name '.DS_Store' -print -delete"

## App Openers

### Browser

browser_u() { open -na 'Firefox' --args --new-window "$@" }
browser_a() { open -na 'Google Chrome' --args --new-window "$@" }

### Spreadsheet

spreadsheet() { open -na 'LibreOffice' --args --calc "$@" }

### DiskUtil

alias dlist="diskutil list"
alias dinfo="diskutil info"

## File System

### Copy Current Directory Path

alias cpwd="pwd | tr -d '\n' | pbcopy"

### Delete Strategies

source "$ZFS/rm_mac"
alias rm=rm_mac

#### Secure Remove

alias srm='/bin/rm'

#### Send To Trash

alias rmt='trash'
alias rmrf='trash'

