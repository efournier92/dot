#!/usr/bin/env zsh
# bootstrap.zsh — install files from docs/installer/manifest, then optionally apps.
emulate -L zsh
setopt no_unset no_extended_glob no_sh_word_split
VERSION="2026-10-28.2"
if [[ -z "$HOME" ]]; then
  print -P "%F{red}[x]%f HOME is not set — cannot determine target paths" >&2
  exit 1
fi
export HOME
typeset -r HOME
typeset -a TAPS=( joshmedeski/sesh )
typeset -a FORMULAS=(
  asdf eza fzf fzf-tab gh git-delta sesh lazygit lazysql neovim
  ripgrep starship tmuxinator unison zoxide
)
typeset -a CASKS=( font-jetbrains-mono-nerd-font ghostty macvim )
DOTFILES_DIR="${DOTFILES_DIR:-${0:A:h:h:h:h:h}}"
_set_paths() {
  DOTFILES_SRC="$DOTFILES_DIR/files"
  MANIFEST_FILE="$DOTFILES_DIR/docs/installer/manifest"
  PERSONAL_MANIFEST="$DOTFILES_DIR/docs/installer/personal.manifest"
  LAUNCHER_TEMPLATE="$DOTFILES_DIR/docs/installer/launcher"
}
_set_paths
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/dot"
INSTALLED="$STATE_DIR/installed.manifest"
LOCK_DIR="$STATE_DIR/lock"
ENTRYPOINT="$HOME/.zsh/scripts/environment/bootstrap"
ENTRYPOINT_REL=".zsh/scripts/environment/bootstrap"
typeset -a PERSONAL_ENV_PROFILES=( primary_macos primary_common )
typeset -gi APPLY=0 YES=0 APPS=0 UPGRADE_ALL=0 DOCTOR=0 HELP=0
typeset -g ENV_NAME_ARG="" ONLY_PHASE="" ENV_NAME="" OS=""
typeset -gA EXPECTED PREV EXPECTED_LC
typeset -ga MOUNTS FORBIDDEN
find_brew() {
  local c
  for c in /opt/homebrew/bin/brew /usr/local/bin/brew /home/linuxbrew/.linuxbrew/bin/brew; do
    [[ -x "$c" ]] && { print -r -- "$c"; return 0; }
  done
  command -v brew 2>/dev/null
}
command_exists() { command -v "$1" >/dev/null 2>&1; }
log_info() { print -P "%F{cyan}[*]%f $1"; }
log_ok()   { print -P "%F{green}[+]%f $1"; }
log_warn() { print -P "%F{yellow}[!]%f $1" >&2; }
log_err()  { print -P "%F{red}[x]%f $1" >&2; }
usage() {
  cat <<'EOF'
Usage: bootstrap [doctor] [options]
Install dotfiles from this repo, and optionally macOS apps.

Options:
  --dry-run          Show what would change; write nothing (default)
  --apply            Write changes
  --yes              Non-interactive; required for --apply off a TTY
  --apps             Install Homebrew formulae and casks
  --upgrade-all      Run 'brew upgrade' during the apps phase
  --env-name NAME    Select the zsh env profile without the menu
  --repo PATH        Use PATH as the dotfiles repo root
  --only PHASE       Run only brew, dotfiles, or verify
  --doctor           Report drift without writing anything
  --help             Show this help
EOF
}
parse_args() {
  while (( $# )); do
    case "$1" in
      --dry-run) APPLY=0 ;;
      --apply) APPLY=1 ;;
      --yes) YES=1 ;;
      --apps) APPS=1 ;;
      --upgrade-all) UPGRADE_ALL=1 ;;
      --env-name) (( $# >= 2 )) || { usage >&2; exit 2; }; ENV_NAME_ARG="$2"; shift ;;
      --env-name=*) ENV_NAME_ARG="${1#*=}" ;;
      --repo) (( $# >= 2 )) || { usage >&2; exit 2; }; DOTFILES_DIR="${2:A}"; _set_paths; shift ;;
      --repo=*) DOTFILES_DIR="${${1#*=}:A}"; _set_paths ;;
      --only) (( $# >= 2 )) || { usage >&2; exit 2; }; ONLY_PHASE="$2"; shift ;;
      --only=*) ONLY_PHASE="${1#*=}" ;;
      --doctor|doctor) DOCTOR=1 ;;
      --help|-h) HELP=1 ;;
      *) usage >&2; exit 2 ;;
    esac
    shift
  done
  if [[ -n "$ONLY_PHASE" && "$ONLY_PHASE" != (brew|dotfiles|verify) ]]; then
    log_err "--only must be one of: brew, dotfiles, verify"; exit 2
  fi
}
_hash_file() { [[ -f "$1" ]] && shasum -a 256 "$1" | awk '{print $1}'; }
_launcher_content() {
  local c="$(<"$LAUNCHER_TEMPLATE")"
  print -r -- "${c//@@DOTFILES_DIR@@/$DOTFILES_DIR}"
}
_launcher_hash() { _launcher_content | shasum -a 256 | awk '{print $1}'; }
detect_os() {
  case "$(uname -s)" in
    Darwin) print -r -- macos ;;
    Linux)
      if [[ -n "${WSL_DISTRO_NAME:-}${WSL_INTEROP:-}" ]] || grep -qiE 'microsoft|WSL' /proc/sys/kernel/osrelease 2>/dev/null; then
        print -r -- wsl
      else print -r -- linux; fi ;;
    *) return 1 ;;
  esac
}
_first_env_line() {
  local line
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [[ -z "$line" || "$line" == \#* ]] && continue
    print -r -- "$line"
    return 0
  done < "$1"
  return 1
}
_read_env() {
  ENV_NAME=""
  if [[ -n "$ENV_NAME_ARG" ]]; then ENV_NAME="$ENV_NAME_ARG"; return; fi
  local line
  if [[ -f "$HOME/.env_name" ]]; then
    line="$(_first_env_line "$HOME/.env_name")" \
      || { log_err "env name unreadable: $HOME/.env_name (comment-only or empty)"; exit 2; }
    ENV_NAME="$line"
    return
  fi
  # minimalist: fresh-machine fallback until ~/.env_name exists — repo default
  [[ -f "$DOTFILES_SRC/.env_name" ]] && ENV_NAME="$(_first_env_line "$DOTFILES_SRC/.env_name")"
}
_validate_env() {
  [[ -z "$ENV_NAME" ]] && return 0
  local p
  local -a valid=()
  for p in "$DOTFILES_SRC/.zsh/env"/*(N); do
    p="${p:t}"
    [[ "$p" == common || "$p" == common_* ]] && continue
    valid+=("$p")
  done
  valid+=("${PERSONAL_ENV_PROFILES[@]}")
  (( ${valid[(Ie)$ENV_NAME]} )) && return 0
  log_err "unknown env profile: $ENV_NAME (valid: ${valid[*]})"
  exit 2
}
setup_forbidden() {
  MOUNTS=(); FORBIDDEN=("$HOME/mnt" "$HOME/Library" "$HOME/.Trash" "$HOME/.dotfiles.bak")
  local mp
  while IFS= read -r mp; do
    [[ -n "$mp" ]] || continue
    MOUNTS+=("$mp")
    [[ "$mp" == "$HOME"/* ]] && FORBIDDEN+=("$mp")
  done < <(mount | sed -n -e 's/.* on \(.*\) type [^ (]* (.*/\1/p' -e 's/.* on \(.*\) (.*/\1/p' \
    | sed -e 's/\\040/ /g' -e 's/\\011/'$'\t''/g' -e 's/\\134/\\\\/g')
}
_under() { [[ "$1" == "$2" || "$1" == "$2"/* ]]; }
_assert_dest() {
  local dest="$1" rel="${2:-}" rp="${1:A}" home="${HOME:A}" f rf p
  [[ "$dest" == / || "$rp" == "$home" ]] && { log_err "refusing to write $dest: home or root"; return 1; }
  [[ "$rp" == "$home"/* ]] || { log_err "refusing to write $dest: outside HOME"; return 1; }
  [[ -z "$rel" || "$dest" == "$HOME/$rel" ]] || { log_err "refusing to write $dest: not HOME/$rel"; return 1; }
  if [[ -z "$rel" ]]; then
    _under "$rp" "${STATE_DIR:A}" || { log_err "refusing to write $dest: outside state dir"; return 1; }
  elif [[ -z "${EXPECTED[$rel]:-}${PREV[$rel]:-}" ]]; then
    log_err "refusing to write $rel: not in any manifest"; return 1
  fi
  for f in "${FORBIDDEN[@]}"; do
    rf="${f:A}"
    _under "$rp" "$rf" && { log_err "refusing to write $dest: forbidden root $f"; return 1; }
  done
  p="${rp:h}"
  for f in "${FORBIDDEN[@]}"; do
    rf="${f:A}"
    _under "$p" "$rf" && { log_err "refusing to write $dest: parent under $f"; return 1; }
  done
  for f in "${MOUNTS[@]}"; do
    [[ "$rp" == "${f:A}" ]] && { log_err "refusing to write $dest: mount point"; return 1; }
  done
  return 0
}
_env_ok() {
  local rel="$1" f tok=""
  [[ "$rel" == .zsh/env/* ]] || return 0
  f="${rel#.zsh/env/}"
  case "$f" in
    *_mac*) tok=macos ;;
    *_linux*) tok=linux ;;
    *_wsl*) tok=wsl ;;
  esac
  if [[ -n "$ENV_NAME" ]]; then [[ -z "$tok" || "$f" == common || "$f" == "common_$OS" || "$f" == "$ENV_NAME" ]]
  else [[ -z "$tok" || "$tok" == "$OS" ]]; fi
}
load_manifest() {
  local file="$1" filter_env="$2" line src dest
  [[ -f "$file" ]] || { log_err "manifest missing: $file"; return 1; }
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%$'\r'}"
    [[ -z "$line" || "$line" == \#* ]] && continue
    if [[ "$line" == *' -> '* ]]; then src="${line%% -> *}"; dest="${line##* -> }"
    else src="$line"; dest="$line"; fi
    (( filter_env )) && ! _env_ok "$dest" && continue
    local seg="" bad=0
    [[ -z "$dest" || "$dest" == /* || "$dest" == */ || "$dest" == *//* || "$dest" == *$'\t'* ]] && bad=1
    for seg in ${(s:/:)dest}; do
      [[ "$seg" == . || "$seg" == .. ]] && bad=1
    done
    (( bad )) && { log_err "refusing manifest dest $dest: invalid path"; return 1; }
    EXPECTED[$dest]="$src"
  done < "$file"
}
_load_prev() {
  PREV=()
  [[ -f "$INSTALLED" ]] || return 0
  local line h r
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ "$line" == *$'\t'* ]] || continue
    h="${line%%$'\t'*}"; r="${line#*$'\t'}"
    [[ -n "$h" && -n "$r" ]] && PREV[$r]="$h"
  done < "$INSTALLED"
}
_load_plan() {
  EXPECTED=(); PREV=()
  _read_env
  _validate_env
  load_manifest "$MANIFEST_FILE" 1 || return 1
  [[ -n "$ENV_NAME" ]] && (( ${PERSONAL_ENV_PROFILES[(Ie)$ENV_NAME]} )) && { load_manifest "$PERSONAL_MANIFEST" 0 || return 1; }
  EXPECTED[$ENTRYPOINT_REL]='@launcher'
  EXPECTED_LC=()
  local k
  for k in ${(k)EXPECTED}; do EXPECTED_LC[${k:l}]="$k"; done
  _load_prev
}
install_dotfiles() {
  local rel src abs want action final srp alias
  local -i ins=0 upd=0 same=0 pruned=0 kept=0
  local -a new_lines
  _load_plan || return 1
  log_info "dotfiles: $DOTFILES_DIR (os=$OS, env=${ENV_NAME:-none})"
  (( APPLY )) || log_info "dry-run: no files will be written"
  # Validate every destination and source before the first write, so a bad
  # manifest entry cannot leave a half-applied run behind.
  for rel in ${(ok)EXPECTED}; do
    _assert_dest "$HOME/$rel" "$rel" || return 1
    src="${EXPECTED[$rel]}"
    if [[ "$src" != @launcher ]]; then
      srp="${DOTFILES_SRC}/${src}"
      [[ -f "$srp" && "${srp:A}" == "${DOTFILES_SRC:A}"/* ]] \
        || { log_err "manifest src invalid or missing: $src"; return 1; }
    fi
    [[ -d "$HOME/$rel" ]] && { log_err "destination exists and is a directory: $rel"; return 1; }
  done
  for rel in ${(ok)PREV}; do [[ -n "${EXPECTED[$rel]:-}" ]] || _assert_dest "$HOME/$rel" "$rel" || return 1; done
  for rel in ${(ok)EXPECTED}; do
    src="${EXPECTED[$rel]}"
    abs="$HOME/$rel"
    _assert_dest "$abs" "$rel" || return 1
    if [[ "$src" == @launcher ]]; then
      want="$(_launcher_hash)"
    else
      want="$(_hash_file "$DOTFILES_SRC/$src")"
    fi
    if [[ ! -f "$abs" ]]; then action=install
    elif [[ "$(_hash_file "$abs")" == "$want" ]]; then action=same
    else action=update; fi
    case "$action" in
      same) (( same++ )); final="$want" ;;
      *)
        if (( APPLY )); then
          mkdir -p "${abs:h}" || { log_err "cannot create ${abs:h}"; return 1; }
          if [[ "$action" == update ]]; then
            # minimalist: rolling single .dotbak (latest prior version), no timestamps
            cp -p "$abs" "$abs.dotbak" || { log_err "backup failed: $rel"; return 1; }
          fi
          if [[ "$src" == @launcher ]]; then
            local tmp="$abs.tmp.$$"
            _launcher_content > "$tmp" && chmod 755 "$tmp" && mv -f "$tmp" "$abs" \
              || { rm -f "$tmp"; log_err "launcher write failed: $rel"; return 1; }
          else
            rsync -a --one-file-system "$DOTFILES_SRC/$src" "$abs" \
              || { log_err "rsync failed: $rel"; return 1; }
          fi
          final="$(_hash_file "$abs")"
          if [[ "$action" == install ]]; then (( ins++ )); log_ok "installed $rel"
          else (( upd++ )); log_ok "updated $rel"; fi
        else
          final="$want"
          if [[ "$action" == install ]]; then (( ins++ )); log_info "would install $rel"
          else (( upd++ )); log_info "would update $rel"; fi
        fi
        ;;
    esac
    new_lines+=("$final"$'\t'"$rel")
  done
  for rel in ${(ok)PREV}; do
    [[ -n "${EXPECTED[$rel]:-}" ]] && continue
    alias="${EXPECTED_LC[${rel:l}]:-}"
    if [[ -n "$alias" && "$alias" != "$rel" ]]; then
      log_warn "case alias of managed file: $rel (managed as $alias)"
      continue
    fi
    abs="$HOME/$rel"
    _assert_dest "$abs" "$rel" || return 1
    [[ -f "$abs" || -L "$abs" ]] || continue
    if [[ "$(_hash_file "$abs")" == "${PREV[$rel]}" ]]; then
      if (( APPLY )); then rm -f "$abs" || return 1; log_ok "pruned $rel"
      else log_info "would prune $rel"; fi
      (( pruned++ ))
    else
      log_warn "keeping modified file: $rel"
      (( kept++ ))
    fi
  done
  local new old=""
  new="$(printf '%s\n' "${new_lines[@]}")"
  [[ -f "$INSTALLED" ]] && old="$(<"$INSTALLED")"
  if [[ "$new" != "$old" ]] && (( APPLY )); then
    _assert_dest "$STATE_DIR" "" || return 1
    _assert_dest "$INSTALLED" "" || return 1
    mkdir -p "$STATE_DIR" || return 1
    chmod 700 "$STATE_DIR" || return 1
    local tmp="$INSTALLED.tmp.$$"
    print -r -- "$new" > "$tmp" && mv -f "$tmp" "$INSTALLED" \
      || { rm -f "$tmp"; return 1; }
    log_ok "state updated"
  fi
  log_ok "dotfiles: $ins installed, $upd updated, $pruned pruned, $same unchanged, $kept kept"
  (( APPLY )) || log_ok "dry-run complete (nothing written)"
}
_doctor() {
  local -i drift=0
  local rel abs target cur lh rh f
  local -i missing=0 changed=0 prune=0
  if [[ ! -f "$INSTALLED" ]]; then
    print -r -- "doctor: installed manifest missing: $INSTALLED"; drift=1
  fi
  if [[ ! -e "$ENTRYPOINT" && ! -L "$ENTRYPOINT" ]]; then
    print -r -- "doctor: entrypoint missing: $ENTRYPOINT"; drift=1
  elif [[ -L "$ENTRYPOINT" ]]; then
    print -r -- "doctor: entrypoint is a symlink; apply will replace it"; drift=1
  else
    lh="$(_launcher_hash)"
    cur="$(_hash_file "$ENTRYPOINT")"
    rh="$(_hash_file "$DOTFILES_SRC/.zsh/scripts/environment/bootstrap")"
    if [[ "$cur" != "$lh" && "$cur" != "$rh" ]]; then
      print -r -- "doctor: entrypoint is stale or baked with another repo path"; drift=1
    fi
  fi
  for rel in ${(ok)EXPECTED}; do
    [[ "$rel" == "$ENTRYPOINT_REL" ]] && continue
    abs="$HOME/$rel"
    if [[ ! -f "$abs" ]]; then
      print -r -- "doctor: missing $rel"; drift=1; (( missing++ )); continue
    fi
    if [[ "$(_hash_file "$abs")" != "$(_hash_file "$DOTFILES_SRC/${EXPECTED[$rel]}")" ]]; then
      print -r -- "doctor: drift $rel"; drift=1; (( changed++ ))
    fi
  done
  for rel in ${(ok)PREV}; do
    [[ -n "${EXPECTED[$rel]:-}" ]] && continue
    abs="$HOME/$rel"
    if [[ -f "$abs" && "$(_hash_file "$abs")" == "${PREV[$rel]}" ]]; then
      print -r -- "doctor: would prune $rel"; drift=1; (( prune++ ))
    fi
  done
  (( drift == 0 )) && { print -r -- "doctor: clean (v$VERSION)"; return 0; }
  print -r -- "doctor: $missing missing, $changed changed, $prune prunable"
  return 1
}
brew() {
  local b; b="$(find_brew)" || { log_err "brew binary not found"; return 127; }
  "$b" "$@"
}
brew_install_if_missing() {
  brew list --formula "$1" >/dev/null 2>&1 && return 0
  brew install "$1" || { log_warn "failed to install formula '$1'"; return 1; }
}
brew_cask_install_if_missing() {
  brew list --cask "$1" >/dev/null 2>&1 && return 0
  brew install --cask "$1" || { log_warn "failed to install cask '$1'"; return 1; }
}
brew_tap_if_missing() {
  brew tap-info "$1" >/dev/null 2>&1 && return 0
  brew tap "$1" || { log_warn "failed to tap '$1'"; return 1; }
  brew tap --trust "$1" >/dev/null 2>&1 || brew trust "$1" >/dev/null 2>&1 || true
}
bootstrap_homebrew() {
  find_brew >/dev/null 2>&1 && { log_info "Homebrew present"; return 0; }
  log_info "installing Homebrew"
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)" \
    || { log_err "Homebrew installer failed"; return 1; }
  local b; b="$(find_brew)" || { log_err "brew not found after install"; return 1; }
  case "$b" in
    /opt/homebrew/bin/brew) eval "$(/opt/homebrew/bin/brew shellenv)" ;;
    /usr/local/bin/brew) eval "$(/usr/local/bin/brew shellenv)" ;;
  esac
}
install_brew_apps() {
  find_brew >/dev/null 2>&1 || { log_warn "brew missing — skipping apps"; return 1; }
  brew update || log_warn "'brew update' failed — continuing"
  local x
  for x in "${TAPS[@]}"; do brew_tap_if_missing "$x"; done
  for x in "${FORMULAS[@]}"; do brew_install_if_missing "$x"; done
  for x in "${CASKS[@]}"; do brew_cask_install_if_missing "$x"; done
  (( UPGRADE_ALL )) && { brew upgrade || log_warn "'brew upgrade' failed"; }
}
setup_dotfiles() {
  [[ -d "$DOTFILES_DIR" ]] || { log_err "dotfiles repo missing: $DOTFILES_DIR"; return 1; }
  install_dotfiles
}
verify_dotfiles() {
  local -i failed=0
  local f dout
  _load_plan || return 1
  for f in "$HOME/.zshenv" "$HOME/.zsh/.zshrc"; do
    if [[ ! -f "$f" ]]; then log_err "missing $f"; failed=1; continue; fi
    if zsh -n "$f"; then log_ok "syntax ok: $f"; else log_err "syntax error: $f"; failed=1; fi
  done
  if dout="$(_doctor)"; then log_ok "doctor clean"
  else print -r -- "$dout"; log_err "doctor reports drift"; failed=1; fi
  (( failed == 0 ))
}
run_phase() {
  local name="$1"
  case "$name" in
    brew)
      (( APPS )) || { log_info "apps not requested — skipping brew phase (use --apps)"; return 0; }
      if (( ! APPLY )); then log_info "dry-run: skipping brew phase"; return 0; fi
      bootstrap_homebrew || return 1
      install_brew_apps || return 1
      ;;
    dotfiles) setup_dotfiles || return 1 ;;
    verify)
      if (( ! APPLY )); then log_info "dry-run: skipping verify phase"; return 0; fi
      verify_dotfiles || return 1
      ;;
    *) log_err "unknown phase '$name'"; return 1 ;;
  esac
  log_ok "phase complete: $name"
}
_release_lock() { rm -f "$LOCK_DIR/pid"; rmdir "$LOCK_DIR" 2>/dev/null; }
_acquire_lock() {
  _assert_dest "$STATE_DIR" "" || return 1
  _assert_dest "$LOCK_DIR" "" || return 1
  mkdir -p "$STATE_DIR" || return 1
  chmod 700 "$STATE_DIR" || return 1
  if ! mkdir "$LOCK_DIR" 2>/dev/null; then
    local lpid=""
    [[ -f "$LOCK_DIR/pid" ]] && lpid="$(<"$LOCK_DIR/pid")"
    if [[ -z "$(command ls -A "$LOCK_DIR" 2>/dev/null)" ]]; then
      # minimalist: SIGKILL between mkdir and the pid write leaks an empty dir; recover it
      log_warn "removing stale lock (no pid)"
      rmdir "$LOCK_DIR" 2>/dev/null && mkdir "$LOCK_DIR" 2>/dev/null \
        || { log_err "another run is active ($LOCK_DIR)"; return 1; }
    elif [[ "$lpid" == <-> && "$lpid" != "$$" ]] && ! kill -0 "$lpid" 2>/dev/null \
      && [[ "$(command ls -A "$LOCK_DIR" 2>/dev/null)" == pid ]]; then
      log_warn "removing stale lock (pid $lpid)"
      rm -f "$LOCK_DIR/pid" && rmdir "$LOCK_DIR" && mkdir "$LOCK_DIR" 2>/dev/null \
        || { log_err "another run is active ($LOCK_DIR)"; return 1; }
    else
      log_err "another run is active ($LOCK_DIR)"; return 1
    fi
  fi
  print -r -- $$ > "$LOCK_DIR/pid"
  # minimalist: zsh fires traps set inside a function when the function
  # returns, which released the lock immediately after acquisition; the
  # zshexit hook plus a top-level signal trap (armed below, before main) is
  # the zsh-native way to hold the lock for the whole run
  zshexit_functions+=(_release_lock)
}
main() {
  parse_args "$@"
  if (( HELP )); then usage; return 0; fi
  if [[ "$(id -u)" == 0 ]]; then
    log_err "refusing to run as root"; exit 1
  fi
  OS="$(detect_os)" || OS=unknown
  setup_forbidden
  [[ -n "${HOME:-}" && -d "$HOME" ]] || { log_err "HOME is not set or is not a directory"; exit 1; }
  [[ -f "$MANIFEST_FILE" ]] || { log_err "manifest missing: $MANIFEST_FILE"; exit 1; }
  [[ -f "$LAUNCHER_TEMPLATE" ]] || { log_err "launcher template missing: $LAUNCHER_TEMPLATE"; exit 1; }
  _assert_dest "$STATE_DIR" "" || exit 1
  if (( DOCTOR )); then _load_plan || exit 1; _doctor; exit $?; fi
  if (( ! APPLY )); then
    log_info "dry-run: no files will be written"
  fi
  if (( APPLY && ! YES )); then
    [[ -t 0 ]] || { log_err "not a TTY: pass --yes (or --dry-run)"; exit 2; }
    local reply=""
    print -n "Apply changes? [y/N] "
    read -r reply || reply=""
    [[ "$reply" == [yY] ]] || { log_err "aborted by user"; exit 1; }
  fi
  (( APPLY )) && { _acquire_lock || exit 1; }
  local -a run
  if [[ -n "$ONLY_PHASE" ]]; then run=("$ONLY_PHASE"); else run=( brew dotfiles verify ); fi
  local phase
  for phase in "${run[@]}"; do
    run_phase "$phase" || exit 1
  done
  log_ok "bootstrap complete (v$VERSION)"
}
trap '_release_lock' INT TERM
main "$@"