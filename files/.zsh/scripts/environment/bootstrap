#!/usr/bin/env zsh
# bootstrap.zsh — install files from docs/installer/manifest into $HOME.
emulate -L zsh
setopt no_unset no_extended_glob no_sh_word_split
VERSION="2026-11-12.1"
if [[ -z "$HOME" ]]; then
  print -P "%F{red}[x]%f HOME is not set — cannot determine target paths" >&2
  exit 1
fi
export HOME
typeset -r HOME
DOTFILES_DIR="${DOTFILES_DIR:-${0:A:h:h:h:h:h}}"
_set_paths() {
  DOTFILES_SRC="$DOTFILES_DIR/files"
  MANIFEST_FILE="$DOTFILES_DIR/docs/installer/manifest"
}
_set_paths
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/dot"
INSTALLED="$STATE_DIR/installed.manifest"
LOCK_DIR="$STATE_DIR/lock"
ARCHIVE_ROOT="$HOME/.dotfiles_archive"
ARCHIVE_DIR="$ARCHIVE_ROOT/$(date +%F)"
ENTRYPOINT="$HOME/.zsh/scripts/environment/bootstrap"
ENTRYPOINT_REL=".zsh/scripts/environment/bootstrap"
typeset -a PERSONAL_ENV_PROFILES=( primary_macos primary_common )
typeset -gi APPLY=0 YES=0 DOCTOR=0 HELP=0
typeset -g ENV_NAME_ARG="" ENV_NAME="" OS=""
typeset -gA EXPECTED PREV EXPECTED_LC ANN
typeset -ga MOUNTS FORBIDDEN ANN_UNKNOWN
log_info() { print -P "%F{cyan}[*]%f $1"; }
log_ok()   { print -P "%F{green}[+]%f $1"; }
log_warn() { print -P "%F{yellow}[!]%f $1" >&2; }
log_err()  { print -P "%F{red}[x]%f $1" >&2; }
usage() {
  cat <<'EOF'
Usage: bootstrap [--dry-run|--apply] [--yes] [--env-name NAME] [--repo PATH] [doctor] [--help]
Install the dotfiles named in docs/installer/manifest into $HOME.

Options:
  --dry-run          Show what would change; write nothing (default)
  --apply            Write changes
  --yes              Non-interactive; required for --apply off a TTY
  --env-name NAME    Select the zsh env profile without the menu
  --repo PATH        Use PATH as the dotfiles repo root
  --doctor           Report drift without writing anything
  --help             Show this help
EOF
}
parse_args() {
  while (( $# )); do
    case "$1" in
      --dry-run) APPLY=0 ;;
      --apply) APPLY=1 ;;
      --yes) YES=1 ;;
      --env-name) (( $# >= 2 )) || { usage >&2; exit 2; }; ENV_NAME_ARG="$2"; shift ;;
      --env-name=*) ENV_NAME_ARG="${1#*=}" ;;
      --repo) (( $# >= 2 )) || { usage >&2; exit 2; }; DOTFILES_DIR="${2:A}"; _set_paths; shift ;;
      --repo=*) DOTFILES_DIR="${${1#*=}:A}"; _set_paths ;;
      --doctor|doctor) DOCTOR=1 ;;
      --help|-h) HELP=1 ;;
      *) usage >&2; exit 2 ;;
    esac
    shift
  done
}
_hash_file() { [[ -f "$1" ]] && shasum -a 256 "$1" | awk '{print $1}'; }
detect_os() {
  case "$(uname -s)" in
    Darwin) print -r -- macos ;;
    Linux)
      if [[ -n "${WSL_DISTRO_NAME:-}${WSL_INTEROP:-}" ]] || grep -qiE 'microsoft|WSL' /proc/sys/kernel/osrelease 2>/dev/null; then
        print -r -- wsl
      else print -r -- linux; fi ;;
    *) return 1 ;;
  esac
}
_first_env_line() {
  local line
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [[ -z "$line" || "$line" == \#* ]] && continue
    print -r -- "$line"
    return 0
  done < "$1"
  return 1
}
_read_env() {
  ENV_NAME=""
  if [[ -n "$ENV_NAME_ARG" ]]; then ENV_NAME="$ENV_NAME_ARG"; return; fi
  local line
  if [[ -f "$HOME/.env_name" ]]; then
    line="$(_first_env_line "$HOME/.env_name")" \
      || { log_err "env name unreadable: $HOME/.env_name (comment-only or empty)"; exit 2; }
    ENV_NAME="$line"
    return
  fi
  log_err "no env profile: create ~/.env_name or pass --env-name"
  exit 2
}
_validate_env() {
  [[ -z "$ENV_NAME" ]] && return 0
  local p
  local -a valid=()
  for p in "$DOTFILES_SRC/.zsh/env"/*(N); do
    p="${p:t}"
    [[ "$p" == common || "$p" == common_* ]] && continue
    valid+=("$p")
  done
  valid+=("${PERSONAL_ENV_PROFILES[@]}")
  (( ${valid[(Ie)$ENV_NAME]} )) && return 0
  log_err "unknown env profile: $ENV_NAME (valid: ${valid[*]})"
  exit 2
}
_seed_env_file() {
  (( APPLY )) || return 0
  [[ -n "$ENV_NAME_ARG" ]] || return 0
  [[ ! -e "$HOME/.env_name" && ! -L "$HOME/.env_name" ]] || return 0
  local tmp="$HOME/.env_name.tmp.$$"
  print -r -- "$ENV_NAME" > "$tmp" || { rm -f "$tmp"; return 1; }
  mv -f "$tmp" "$HOME/.env_name" || { rm -f "$tmp"; return 1; }
  log_ok "seeded ~/.env_name ($ENV_NAME)"
}
setup_forbidden() {
  MOUNTS=(); FORBIDDEN=("$HOME/mnt" "$HOME/Library" "$HOME/.Trash" "$HOME/.dotfiles.bak" "$ARCHIVE_ROOT")
  local mp
  while IFS= read -r mp; do
    [[ -n "$mp" ]] || continue
    MOUNTS+=("$mp")
    [[ "$mp" == "$HOME"/* ]] && FORBIDDEN+=("$mp")
  done < <(mount | sed -n -e 's/.* on \(.*\) type [^ (]* (.*/\1/p' -e 's/.* on \(.*\) (.*/\1/p' \
    | sed -e 's/\\040/ /g' -e 's/\\011/'$'\t''/g' -e 's/\\134/\\\\/g')
}
_under() { [[ "$1" == "$2" || "$1" == "$2"/* ]]; }
_assert_dest() {
  local dest="$1" rel="${2:-}" noref="${3:-}" rp home f rf p
  home="${HOME:A}"
  if [[ "$noref" == nores ]]; then rp="${1:h:A}/${1:t}"
  else rp="${1:A}"; fi
  [[ "$dest" == / || "$rp" == "$home" ]] && { log_err "refusing to write $dest: home or root"; return 1; }
  [[ "$rp" == "$home"/* ]] || { log_err "refusing to write $dest: outside HOME"; return 1; }
  [[ -z "$rel" || "$dest" == "$HOME/$rel" ]] || { log_err "refusing to write $dest: not HOME/$rel"; return 1; }
  if [[ -z "$rel" ]]; then
    _under "$rp" "${STATE_DIR:A}" || { log_err "refusing to write $dest: outside state dir"; return 1; }
  elif [[ -z "${EXPECTED[$rel]:-}${PREV[$rel]:-}" ]]; then
    log_err "refusing to write $rel: not in any manifest"; return 1
  fi
  for f in "${FORBIDDEN[@]}"; do
    rf="${f:A}"
    _under "$rp" "$rf" && { log_err "refusing to write $dest: forbidden root $f"; return 1; }
  done
  p="${rp:h}"
  for f in "${FORBIDDEN[@]}"; do
    rf="${f:A}"
    _under "$p" "$rf" && { log_err "refusing to write $dest: parent under $f"; return 1; }
  done
  for f in "${MOUNTS[@]}"; do
    [[ "$rp" == "${f:A}" ]] && { log_err "refusing to write $dest: mount point"; return 1; }
  done
  return 0
}
_assert_archive() {
  local dest="$1" rp="${1:A}" home="${HOME:A}" ar="${ARCHIVE_ROOT:A}" f rf
  [[ -L "$ARCHIVE_ROOT" ]] && { log_err "refusing archive write $dest: archive root is a symlink"; return 1; }
  [[ "$rp" == "$home"/* ]] || { log_err "refusing archive write $dest: outside HOME"; return 1; }
  _under "$rp" "$ar" || { log_err "refusing archive write $dest: outside archive root"; return 1; }
  for f in "${FORBIDDEN[@]}"; do
    rf="${f:A}"
    [[ "$rf" == "$ar" ]] && continue
    _under "$rp" "$rf" && { log_err "refusing archive write $dest: forbidden root $f"; return 1; }
  done
  for f in "${MOUNTS[@]}"; do
    [[ "$rp" == "${f:A}" ]] && { log_err "refusing archive write $dest: mount point"; return 1; }
  done
  return 0
}
_archive_path() {
  local cand="$ARCHIVE_DIR/$1" n=1
  while [[ -e "$cand" || -L "$cand" ]]; do
    cand="$ARCHIVE_DIR/$1.$n"
    (( n++ ))
  done
  print -r -- "$cand"
}
_archive_move() {
  local rel="$1" src="$HOME/$1" dst
  dst="$(_archive_path "$rel")"
  _assert_archive "$dst" || return 1
  mkdir -p "${dst:h}" || { log_err "cannot create archive dir: ${dst:h}"; return 1; }
  mv -- "$src" "$dst" || { log_err "archive move failed: $rel"; return 1; }
}
_archive_copy() {
  local rel="$1" src="$HOME/$1" dst
  dst="$(_archive_path "$rel")"
  _assert_archive "$dst" || return 1
  mkdir -p "${dst:h}" || { log_err "cannot create archive dir: ${dst:h}"; return 1; }
  cp -pP "$src" "$dst" || { log_err "archive copy failed: $rel"; return 1; }
}
_entry_ok() {
  local rel="$1" annset="$2" tok osann="" b
  local -i personal=0
  local -a toks
  toks=(${=annset})
  for tok in "${toks[@]}"; do
    case "$tok" in
      @macos) osann=macos ;;
      @linux) osann=linux ;;
      @wsl) osann=wsl ;;
      @personal) personal=1 ;;
      *) ANN_UNKNOWN+=("$tok") ;;
    esac
  done
  b="${rel:t}"
  if [[ -z "$osann" ]]; then
    case "$b" in
      *_mac*) osann=macos ;;
      *_linux*) osann=linux ;;
      *_wsl*) osann=wsl ;;
    esac
  fi
  [[ -n "$osann" && "$osann" != "$OS" ]] && return 1
  if (( personal )); then
    (( ${PERSONAL_ENV_PROFILES[(Ie)$ENV_NAME]} )) || return 1
  fi
  return 0
}
load_manifest() {
  local file="$1" line src dest ann tok seg
  EXPECTED=(); ANN=(); ANN_UNKNOWN=()
  [[ -f "$file" ]] || { log_err "manifest missing: $file"; return 1; }
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%$'\r'}"
    [[ -z "$line" || "$line" == \#* ]] && continue
    ann=""
    while [[ "$line" == *[[:space:]]@* ]]; do
      tok="${line##*[[:space:]]}"
      [[ "$tok" == @* ]] || break
      ann="$tok${ann:+ }$ann"
      line="${line%[[:space:]]$tok}"
      line="${line%"${line##*[![:space:]]}"}"
    done
    if [[ "$line" == *' -> '* ]]; then src="${line%% -> *}"; dest="${line##* -> }"
    else src="$line"; dest="$line"; fi
    local bad=0
    [[ -z "$dest" || "$dest" == /* || "$dest" == */ || "$dest" == *//* || "$dest" == *$'\t'* ]] && bad=1
    for seg in ${(s:/:)dest}; do
      [[ "$seg" == . || "$seg" == .. ]] && bad=1
    done
    (( bad )) && { log_err "refusing manifest dest $dest: invalid path"; return 1; }
    ANN[$dest]="$ann"
    if _entry_ok "$dest" "$ann"; then
      EXPECTED[$dest]="$src"
    else
      log_info "skip $dest (os/env scope)"
    fi
  done < "$file"
}
_load_prev() {
  PREV=()
  [[ -f "$INSTALLED" ]] || return 0
  local line h r
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ "$line" == *$'\t'* ]] || continue
    h="${line%%$'\t'*}"; r="${line#*$'\t'}"
    [[ -n "$h" && -n "$r" ]] && PREV[$r]="$h"
  done < "$INSTALLED"
}
_load_plan() {
  EXPECTED=(); PREV=()
  _read_env
  _validate_env
  load_manifest "$MANIFEST_FILE" || return 1
  EXPECTED[$ENTRYPOINT_REL]='@symlink'
  EXPECTED_LC=()
  local k
  for k in ${(k)EXPECTED}; do EXPECTED_LC[${k:l}]="$k"; done
  _load_prev
}
install_dotfiles() {
  local rel src abs want action final srp alias
  local -i ins=0 upd=0 same=0 pruned=0 kept=0
  local -a new_lines
  local link_target="$DOTFILES_SRC/.zsh/scripts/environment/bootstrap"
  _load_plan || return 1
  _seed_env_file || return 1
  log_info "dotfiles: $DOTFILES_DIR (os=$OS, env=${ENV_NAME:-none})"
  (( APPLY )) || log_info "dry-run: no files will be written"
  # Validate every destination and source before the first write, so a bad
  # manifest entry cannot leave a half-applied run behind.
  for rel in ${(ok)EXPECTED}; do
    (( ${#ANN_UNKNOWN} )) && { log_err "unknown manifest annotation: ${ANN_UNKNOWN[1]}"; return 1; }
    src="${EXPECTED[$rel]}"
    if [[ "$src" == '@symlink' ]]; then
      _assert_dest "$HOME/$rel" "$rel" nores || return 1
    else
      _assert_dest "$HOME/$rel" "$rel" || return 1
      srp="${DOTFILES_SRC}/${src}"
      [[ -f "$srp" && "${srp:A}" == "${DOTFILES_SRC:A}"/* ]] \
        || { log_err "manifest src invalid or missing: $src"; return 1; }
    fi
    [[ -d "$HOME/$rel" ]] && { log_err "destination exists and is a directory: $rel"; return 1; }
  done
  for rel in ${(ok)PREV}; do [[ -n "${EXPECTED[$rel]:-}" ]] || _assert_dest "$HOME/$rel" "$rel" || return 1; done
  if (( APPLY )); then
    if [[ -L "$ARCHIVE_ROOT" ]]; then log_err "archive root is a symlink: $ARCHIVE_ROOT"; return 1; fi
    if [[ -e "$ARCHIVE_ROOT" && ! -d "$ARCHIVE_ROOT" ]]; then log_err "archive root is not a directory: $ARCHIVE_ROOT"; return 1; fi
    mkdir -p "$ARCHIVE_ROOT" "$ARCHIVE_DIR" || { log_err "cannot create archive: $ARCHIVE_DIR"; return 1; }
    chmod 700 "$ARCHIVE_ROOT" "$ARCHIVE_DIR" || { log_err "cannot chmod archive: $ARCHIVE_ROOT"; return 1; }
  fi
  for rel in ${(ok)EXPECTED}; do
    src="${EXPECTED[$rel]}"
    abs="$HOME/$rel"
    if [[ "$src" == '@symlink' ]]; then
      _assert_dest "$abs" "$rel" nores || return 1
      want="$(_hash_file "$link_target")"
      if [[ -L "$abs" && "$(readlink "$abs")" == "$link_target" ]]; then action=same
      elif [[ -e "$abs" || -L "$abs" ]]; then action=update
      else action=install; fi
    else
      _assert_dest "$abs" "$rel" || return 1
      want="$(_hash_file "$DOTFILES_SRC/$src")"
      if [[ ! -f "$abs" ]]; then action=install
      elif [[ "$(_hash_file "$abs")" == "$want" ]]; then action=same
      else action=update; fi
    fi
    case "$action" in
      same) (( same++ )); final="$want" ;;
      *)
        if (( APPLY )); then
          mkdir -p "${abs:h}" || { log_err "cannot create ${abs:h}"; return 1; }
          if [[ "$action" == update ]]; then
            _archive_copy "$rel" || return 1
            log_ok "archived $rel"
          fi
          if [[ "$src" == '@symlink' ]]; then
            ln -sfn "$link_target" "$abs" || { log_err "symlink failed: $rel"; return 1; }
          else
            local tmp="$abs.tmp.$$"
            rsync -a --one-file-system "$DOTFILES_SRC/$src" "$tmp" \
              || { rm -f "$tmp"; log_err "rsync failed: $rel"; return 1; }
            mv -f "$tmp" "$abs" || { rm -f "$tmp"; log_err "write failed: $rel"; return 1; }
          fi
          final="$(_hash_file "$abs")"
          if [[ "$action" == install ]]; then (( ins++ )); log_ok "installed $rel"
          else (( upd++ )); log_ok "updated $rel"; fi
        else
          final="$want"
          if [[ "$action" == install ]]; then (( ins++ )); log_info "would install $rel"
          else (( upd++ )); log_info "would archive $rel"; log_info "would update $rel"; fi
        fi
        ;;
    esac
    new_lines+=("$final"$'\t'"$rel")
  done
  for rel in ${(ok)PREV}; do
    [[ -n "${EXPECTED[$rel]:-}" ]] && continue
    alias="${EXPECTED_LC[${rel:l}]:-}"
    if [[ -n "$alias" && "$alias" != "$rel" ]]; then
      log_warn "case alias of managed file: $rel (managed as $alias)"
      abs="$HOME/$rel"
      if (( APPLY )) && [[ -e "$abs" ]] && ! [[ "$abs" -ef "$HOME/$alias" ]]; then
        _assert_dest "$abs" "$rel" || return 1
        _archive_move "$rel" || return 1
        log_ok "archived $rel"
      fi
      continue
    fi
    abs="$HOME/$rel"
    _assert_dest "$abs" "$rel" || return 1
    [[ -f "$abs" || -L "$abs" ]] || continue
    if [[ "$(_hash_file "$abs")" == "${PREV[$rel]}" ]]; then
      if (( APPLY )); then
        _archive_move "$rel" || return 1
        log_ok "archived $rel"
        log_ok "pruned $rel"
      else
        log_info "would archive $rel"
        log_info "would prune $rel"
      fi
      (( pruned++ ))
    else
      log_warn "keeping modified file: $rel"
      (( kept++ ))
    fi
  done
  local new old=""
  new="$(printf '%s\n' "${new_lines[@]}")"
  [[ -f "$INSTALLED" ]] && old="$(<"$INSTALLED")"
  if [[ "$new" != "$old" ]] && (( APPLY )); then
    _assert_dest "$STATE_DIR" "" || return 1
    _assert_dest "$INSTALLED" "" || return 1
    mkdir -p "$STATE_DIR" || return 1
    chmod 700 "$STATE_DIR" || return 1
    local tmp="$INSTALLED.tmp.$$"
    print -r -- "$new" > "$tmp" && mv -f "$tmp" "$INSTALLED" \
      || { rm -f "$tmp"; return 1; }
    log_ok "state updated"
  fi
  log_ok "dotfiles: $ins installed, $upd updated, $pruned pruned, $same unchanged, $kept kept"
  (( APPLY )) || log_ok "dry-run complete (nothing written)"
}
_doctor() {
  local -i drift=0
  local rel abs link
  local -i missing=0 changed=0 prune=0
  link="$DOTFILES_SRC/.zsh/scripts/environment/bootstrap"
  if [[ ! -f "$INSTALLED" ]]; then
    print -r -- "doctor: installed manifest missing: $INSTALLED"; drift=1
  fi
  if [[ ! -L "$ENTRYPOINT" ]]; then
    print -r -- "doctor: entrypoint is not a symlink: $ENTRYPOINT"; drift=1
  elif [[ "$(readlink "$ENTRYPOINT")" != "$link" ]]; then
    print -r -- "doctor: entrypoint target drift: $ENTRYPOINT"; drift=1
  fi
  for rel in ${(ok)EXPECTED}; do
    [[ "$rel" == "$ENTRYPOINT_REL" ]] && continue
    abs="$HOME/$rel"
    if [[ ! -f "$abs" ]]; then
      print -r -- "doctor: missing $rel"; drift=1; (( missing++ )); continue
    fi
    if [[ "$(_hash_file "$abs")" != "$(_hash_file "$DOTFILES_SRC/${EXPECTED[$rel]}")" ]]; then
      print -r -- "doctor: drift $rel"; drift=1; (( changed++ ))
    fi
  done
  for rel in ${(ok)PREV}; do
    [[ -n "${EXPECTED[$rel]:-}" ]] && continue
    abs="$HOME/$rel"
    if [[ -f "$abs" && "$(_hash_file "$abs")" == "${PREV[$rel]}" ]]; then
      print -r -- "doctor: would prune $rel"; drift=1; (( prune++ ))
    fi
  done
  (( drift == 0 )) && { print -r -- "doctor: clean (v$VERSION)"; return 0; }
  print -r -- "doctor: $missing missing, $changed changed, $prune prunable"
  return 1
}
_release_lock() { rm -f "$LOCK_DIR/pid"; rmdir "$LOCK_DIR" 2>/dev/null; }
_acquire_lock() {
  _assert_dest "$STATE_DIR" "" || return 1
  _assert_dest "$LOCK_DIR" "" || return 1
  mkdir -p "$STATE_DIR" || return 1
  chmod 700 "$STATE_DIR" || return 1
  if ! mkdir "$LOCK_DIR" 2>/dev/null; then
    local lpid=""
    [[ -f "$LOCK_DIR/pid" ]] && lpid="$(<"$LOCK_DIR/pid")"
    if [[ -z "$(command ls -A "$LOCK_DIR" 2>/dev/null)" ]]; then
      # minimalist: SIGKILL between mkdir and the pid write leaks an empty dir; recover it
      log_warn "removing stale lock (no pid)"
      rmdir "$LOCK_DIR" 2>/dev/null && mkdir "$LOCK_DIR" 2>/dev/null \
        || { log_err "another run is active ($LOCK_DIR)"; return 1; }
    elif [[ "$lpid" == <-> && "$lpid" != "$$" ]] && ! kill -0 "$lpid" 2>/dev/null \
      && [[ "$(command ls -A "$LOCK_DIR" 2>/dev/null)" == pid ]]; then
      log_warn "removing stale lock (pid $lpid)"
      rm -f "$LOCK_DIR/pid" && rmdir "$LOCK_DIR" && mkdir "$LOCK_DIR" 2>/dev/null \
        || { log_err "another run is active ($LOCK_DIR)"; return 1; }
    else
      log_err "another run is active ($LOCK_DIR)"; return 1
    fi
  fi
  print -r -- $$ > "$LOCK_DIR/pid"
  # minimalist: zsh fires traps set inside a function when the function
  # returns, which released the lock immediately after acquisition; the
  # zshexit hook plus a top-level signal trap (armed below, before main) is
  # the zsh-native way to hold the lock for the whole run
  zshexit_functions+=(_release_lock)
}
main() {
  parse_args "$@"
  if (( HELP )); then usage; return 0; fi
  if [[ "$(id -u)" == 0 ]]; then
    log_err "refusing to run as root"; exit 1
  fi
  OS="$(detect_os)" || OS=unknown
  setup_forbidden
  [[ -n "${HOME:-}" && -d "$HOME" ]] || { log_err "HOME is not set or is not a directory"; exit 1; }
  [[ -f "$MANIFEST_FILE" ]] || { log_err "manifest missing: $MANIFEST_FILE"; exit 1; }
  _assert_dest "$STATE_DIR" "" || exit 1
  if (( DOCTOR )); then _load_plan || exit 1; _doctor; exit $?; fi
  if (( ! APPLY )); then
    log_info "dry-run: no files will be written"
  fi
  if (( APPLY && ! YES )); then
    [[ -t 0 ]] || { log_err "not a TTY: pass --yes (or --dry-run)"; exit 2; }
    local reply=""
    print -n "Apply changes? [y/N] "
    read -r reply || reply=""
    [[ "$reply" == [yY] ]] || { log_err "aborted by user"; exit 1; }
  fi
  (( APPLY )) && { _acquire_lock || exit 1; }
  [[ -d "$DOTFILES_DIR" ]] || { log_err "dotfiles repo missing: $DOTFILES_DIR"; return 1; }
  install_dotfiles || exit 1
  log_ok "bootstrap complete (v$VERSION)"
}
trap '_release_lock' INT TERM
main "$@"
