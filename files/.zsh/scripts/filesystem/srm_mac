#!/bin/bash

#----------------
# Name          : srm_mac
# Description   : Secure-delete for sensitive files & directories.
# Author        : E Fournier
# Dependencies  : gpg (brew install gnupg)
# Example Usage : ./srm_mac file|dir [...]
#----------------

main() {
  if (( $# == 0 )); then
    printf '%s\n' "srm: usage: srm file|dir [...]   # secure-delete (encrypts first)" >&2
    return 2
  fi
  if ! command -v gpg >/dev/null 2>&1; then
    printf '%s\n' "srm: gnupg not installed. Run: brew install gnupg" >&2
    return 1
  fi

  # 256 bits of random entropy, never written to disk or argv. Fed to gpg
  # via fd 3 with a here-string. Discarded at function return.
  local pass
  pass=$(head -c 32 /dev/urandom | base64)

  local -a files=()
  local arg
  for arg in "$@"; do
    [[ $arg != -* ]] && files+=("$arg")
  done

  local f rc=0 stamp
  for f in "${files[@]}"; do
    if [[ ! -e $f ]]; then
      printf '%s\n' "srm: $f: No such file or directory" >&2
      rc=1; continue
    fi

    stamp=$(date +%s%N)

    if [[ -d $f ]]; then
      # Directory: stream tar through gpg to a single encrypted archive.
      local archive="${f%/}.srm.${stamp}.tar.enc"
      if tar -cf - -- "$f" | gpg --batch --yes --symmetric \
            --cipher-algo AES256 --passphrase-fd 3 \
            --output "$archive" 3<<<"$pass"; then
        if /bin/rm -rf -- "$f" && /bin/rm -- "$archive"; then
          printf '%s\n' "srm: $f/ (deleted securely)"
        else
          printf '%s\n' "srm: $f: encrypted to $archive but cleanup failed" >&2
          rc=1
        fi
      else
        /bin/rm -- "$archive" 2>/dev/null
        printf '%s\n' "srm: $f: encryption failed, leaving directory untouched" >&2
        rc=1
      fi
    else
      # File: encrypt to tmp, unlink both plaintext and ciphertext.
      local tmp="${f}.srm.${stamp}.enc"
      if gpg --batch --yes --symmetric --cipher-algo AES256 \
            --passphrase-fd 3 --output "$tmp" -- "$f" 3<<<"$pass"; then
        if /bin/rm -- "$f" && /bin/rm -- "$tmp"; then
          printf '%s\n' "srm: $f (deleted securely)"
        else
          printf '%s\n' "srm: $f: encrypted to $tmp but failed to clean up" >&2
          rc=1
        fi
      else
        /bin/rm -- "$tmp" 2>/dev/null
        printf '%s\n' "srm: $f: encryption failed, leaving file untouched" >&2
        rc=1
      fi
    fi
  done
  return $rc
}

main "$@"
