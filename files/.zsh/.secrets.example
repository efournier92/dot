#----------------
# Name          : .secrets.example
# Description   : Variable names consumed by the zsh environment, with placeholders
# Dependencies  : zsh
#----------------

# This file is never read by the configuration. Copy it to ~/.zsh/.secrets and
# put real values there. ~/.zsh/.secrets and ~/.zsh/.secrets_savvy are ignored
# by git; never commit either one.

## Llm

### MiniMax | consumed by env/config_llm

export MINIMAX_API_KEY="replace-me"

### OpenRouter | consumed by the commented block in env/config_llm

export OPENROUTER_API_KEY="replace-me"

## Tickets

### Root of the Atlassian site | consumed by InsertTicketLink in .vimrc
### and by .zsh/scripts/development/agile_ticket_create. Not a secret.

# export TICKET_URL_BASE="https://example.atlassian.net"

## Docker

### Dev login used by .zsh/scripts/development/docker_rebuild when the
### web-app .env has no DEV_LOGIN_EMAIL. Not a secret.

# export DEV_LOGIN_EMAIL="dev@example.com"
