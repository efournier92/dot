#----------------
# Name          : .env_name.example
# Description   : The active zsh environment profile, selected per machine
# Dependencies  : zsh
#----------------

# env/common reads the first line of ~/.env_name and sources ~/.zsh/env/<name>.
# Bootstrap copies this file to ~/.env_name and writes the chosen profile on
# line 1. Every uncommented line below is a menu candidate; blank and # lines
# are ignored. ~/.env_name is machine-local and ignored by git.

## macOS | personal

primary_macos

## macOS | work

work_macos_silicon
work_macos_intel

## Linux

common_linux
sb_linux
ssh_linux
vm_linux_debian_xfce
media_linux_manjaro_gnome
media_linux_ubuntu_lxde
media_linux_ubuntu_xfce
media_slideshow_linux_ubuntu_lxde
fmedia_linux_lubuntu
fmedia_linux_raspberry
llm_linux_ubuntu_xfce
primary_linux_manjaro_gnome
primary_linux_root
primary_linux_ubuntu_gnome

## Windows | WSL

work_wsl_ubuntu
