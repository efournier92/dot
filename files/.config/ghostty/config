# Startup
# Requires ~/.zsh/scripts/start/tmux -- ships in this repo at .zsh/scripts/start/tmux.

command = ~/.zsh/scripts/start/tmux

term = xterm-256color

# Appearance

theme = "Kanagawa Wave"
background = #000000
font-family = "JetBrainsMono Nerd Font"
font-size = 17
## Disable ligatures
font-feature = -calt
font-feature = -liga
font-feature = -dlig

# Window

shell-integration-features = no-title
macos-titlebar-style = hidden
## Disable warning when closing a window
confirm-close-surface = false

