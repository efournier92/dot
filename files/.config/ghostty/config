# Startup

#command = /bin/zsh -c "while true; do tmuxinator start BSE; done"
#command = /bin/zsh -c "while true; do /bin/zsh ~/.tmux/sessions/base.session; done"
#command = /bin/zsh -c "tmuxinator start BSE"
#command = /bin/zsh -c "tmux"
#command = /bin/zsh -l -i -c "tmuxinator start BSE"
command = ~/.zsh/scripts/start/tmux

# Appearance

theme = "Kanagawa Wave"
background = #000000
font-family = "JetBrainsMono Nerd Font"
font-size = 17
## Disable ligatures
font-feature = -calt
font-feature = -liga
font-feature = -dlig

# Window

shell-integration-features = no-title
macos-titlebar-style = hidden
## Disable warning when closing a window
confirm-close-surface = false

