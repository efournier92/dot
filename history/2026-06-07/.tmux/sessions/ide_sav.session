#!/bin/zsh

#----------------
# Name          : ide.session
# Description   : Launches a tmux session configured for IDE use case
# Author        : E Fournier
# Dependencies  : tmux, zsh, vim
#----------------

## Load ZSH configuration

source "$HOME/.zsh/.zshrc"

## Session Attributes

SESSION_NAME="$1"
DEV_DIR="$CS/Savvy"
BE_RAILS_DIR="$DEV_DIR/backend-service"
FE_REACT_DIR="$DEV_DIR/web-app"
BE_PVS_DIR="$DEV_DIR/portfolio-valuation-service"
SPLIT_PERCENT=40

## Check if session already exists

tmux has-session -t "$SESSION_NAME" 2>/dev/null

## New Session

if [[ "$?" -eq 1 ]] ; then
  ## Window 1

  ### Left Pane - nvim | Right Pane - claude

  tmux new -s "$SESSION_NAME" -d -c "$BE_RAILS_DIR"
  tmux split-window -p $SPLIT_PERCENT -h -t "$SESSION_NAME:0.0" -c "$BE_RAILS_DIR"
  tmux send-keys -t "$SESSION_NAME:0.0" "nvim ." Enter
  tmux send-keys -t "$SESSION_NAME:0.1" "claude"
  tmux select-pane -t "$SESSION_NAME:0.1"

  ## Window 2

  ### Left Pane - nvim | Right Pane - claude
  
  tmux new-window -t "$SESSION_NAME:1" -c "$FE_REACT_DIR"
  tmux split-window -p $SPLIT_PERCENT -h -t "$SESSION_NAME:1.0" -c "$FE_REACT_DIR"
  tmux send-keys -t "$SESSION_NAME:1.0" "nvim ." Enter
  tmux send-keys -t "$SESSION_NAME:1.1" "claude"
  tmux select-pane -t "$SESSION_NAME:0.1"

  ## Window 3

  ### Left Pane - nvim | Right Pane - claude
  
  tmux new-window -t "$SESSION_NAME:2" -c "$BE_PVS_DIR"
  tmux split-window -p $SPLIT_PERCENT -h -t "$SESSION_NAME:2.0" -c "$BE_PVS_DIR"
  tmux send-keys -t "$SESSION_NAME:2.0" "cd $BE_PVS_DIR; nvim ." Enter
  tmux send-keys -t "$SESSION_NAME:2.1" "claude"
  tmux select-pane -t "$SESSION_NAME:2.1"

  ## Window 2

  ### Left Pane (50%) - make rails | Right Pane (50%) - make console

  #tmux new-window -t "$SESSION_NAME:1" -c "$DEV_DIR"
  #tmux send-keys -t "$SESSION_NAME:1.0" "make spec"
fi

## Attach to session

tmux select-window -t "$SESSION_NAME:0"
tmux select-pane -t "$SESSION_NAME:0.1"
tmux attach -t "$SESSION_NAME"

## Switch to session

tmux switch-client -t "$SESSION_NAME" &

