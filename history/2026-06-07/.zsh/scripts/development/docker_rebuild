#!/bin/bash

#----------------
# Name          : docker_rebuild
# Description   : Purges docker and rebuilds the app in the current directory
# Author        : E Fournier
# Dependencies  : docker_clean
# Example Usage : ./docker_rebuild
#----------------

print_line() {
  echo "--------" >&2
}

print_header() {
  local message="$1"

  print_line
  echo "$message" >&2
  print_line
}

get_containers() {
  docker ps -aq
}

stop_all_containers() {
  local containers
  containers=$(get_containers)
  [[ -z "$containers" ]] && return

  print_header "STOPPING DOCKER CONTAINERS"
  docker stop $containers
}

delete_containers() {
  stop_all_containers
  local containers
  containers=$(get_containers)
  [[ -z "$containers" ]] && return

  print_header "DELETING DOCKER CONTAINERS"
  docker rm -vf $containers
}

delete_images() {
  print_header "DELETING DOCKER IMAGES"
  local images
  images=$(docker images -aq)
  [[ -n "$images" ]] && docker rmi -f $images
}

delete_volumes() {
  print_header "DELETING DOCKER VOLUMES"
  local volumes
  volumes=$(docker volume ls -q --filter dangling=true)
  [[ -n "$volumes" ]] && docker volume rm $volumes
  print_line
}

delete_all() {
  delete_containers
  delete_images
  delete_volumes
}

docker_clean() {
  local mode="$1"

  if [[ "$mode" =~ "c" ]]; then
    delete_containers
  else
    delete_all
  fi
}

clear_rails_schema() {
  print_header "CLEARING RAILS SCHEMA"

  local count=0
  [[ -f "db/schema.rb" ]] && { rm "db/schema.rb"; ((count++)); }
  [[ -f "db/cache_schema.rb" ]] && { rm "db/cache_schema.rb"; ((count++)); }

  if [[ $count -gt 0 ]]; then
    echo "Deleted $count schema file(s)" >&2
  else
    echo "No schema files to delete" >&2
  fi
}

initialize_via_make_up() {
  print_header "RUNNING INITIAL MAKE UP"
  local log_file="/tmp/make_up_$$.log"
  make up 2>&1 | tee "$log_file" &

  # Wait for the Rails server to start listening (give up after 4 minutes)
  local timeout=240
  local elapsed=0
  while [[ $elapsed -lt $timeout ]]; do
    if grep -q "Listening on http://0.0.0.0:3000" "$log_file"; then
      break
    fi
    sleep 1
    ((elapsed++))
  done

  print_header "STOPPING CONTAINERS AFTER INITIAL MAKE UP"
  stop_all_containers

  rm -f "$log_file"
}

pull_latest_by_project() {
  local project="$1"

  pushd "$project" > /dev/null || return 1

  echo "---------------" >&2
  echo "PULLING LATEST: $project" >&2
  echo "---------------" >&2

  if git pull > /dev/null 2>&1; then
    echo "Successfully pulled $project" >&2
  else
    echo "Could not pull $project (check upstream tracking)" >&2
  fi

  popd > /dev/null
}

pull_latest_repos() {
  pushd .. > /dev/null || return 1

  pull_latest_by_project "backend-service"
  pull_latest_by_project "web-app"
  pull_latest_by_project "portfolio-valuation-service"
  #pull_latest_by_project "order-execution-service"

  popd > /dev/null
}

main() {
  pull_latest_repos

  clear_rails_schema

  docker_clean

  make build

  docker_clean "c"

  initialize_via_make_up

  make up
}

main "$@"

